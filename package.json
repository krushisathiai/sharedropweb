{
  "name": "sharedrop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,CLIENT\" -c \"blue,magenta\" \"node backend/index.js\" \"vite --host\"",
    "client": "vite --host",
    "backend": "node backend/index.js",
